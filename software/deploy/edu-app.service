[Unit]
Description=AI microscope teaching kiosk (PySide6, no desktop)
Documentation=file:///home/cat/ai-microscope-edu/software/README.md
After=systemd-udev-settle.service
Conflicts=scandog.service mipi-hmi.service edu-kiosk-probe.service

[Service]
Type=simple
User=cat
Group=cat
SupplementaryGroups=video render input audio
WorkingDirectory=/home/cat/ai-microscope-edu/software
Environment=PYTHONUNBUFFERED=1
Environment=EDU_SENSEVOICE_DEMO=/home/cat/ai-microscope-edu/models/sensevoice/sensevoice_demo
Environment=EDU_SENSEVOICE_MODEL=/home/cat/ai-microscope-edu/models/sensevoice/sensevoice_f32.rknn
Environment=EDU_SENSEVOICE_TOKENS=/home/cat/ai-microscope-edu/models/sensevoice/tokens.txt
Environment=EDU_TTS_MODEL_DIR=/home/cat/ai-microscope-edu/models/matcha-icefall-zh-baker
Environment=EDU_TTS_VOCODER=/home/cat/ai-microscope-edu/models/vocos-22khz-univ.onnx
# Mesa 缺 EGL_EXT_device_base，eglfs_kms 会 ABRT。先走 linuxfb 运行教学壳。
# 后续接通硬件加速时再验证 Mali GBM + eglfs（见 README）。
Environment=QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0
Environment=QT_QPA_FB_HIDECURSOR=1
# 避免 Debian Qt 6.4 的 libQt6VirtualKeyboard 抢在 PySide 6.8 前面。
Environment=LD_LIBRARY_PATH=/home/cat/ai-microscope-edu/.venv/lib/python3.11/site-packages/PySide6/Qt/lib
Environment=QT_IM_MODULE=qtvirtualkeyboard
Environment=QT_VIRTUALKEYBOARD_DESKTOP_DISABLE=1
Environment=QT_QUICK_BACKEND=software
Environment=LANG=zh_CN.UTF-8
Environment=QT_VIRTUALKEYBOARD_AVAILABLE_LOCALES=zh_CN,zh_TW,en_US
ExecStartPre=+/usr/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon1/bind || true'
ExecStart=/home/cat/ai-microscope-edu/.venv/bin/python -m app
ExecStartPost=/home/cat/ai-microscope-edu/software/deploy/edu-mixer.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
